#!/system/bin/sh
set -eu
set -o pipefail
base=/data/adb/nh-open
state=/dev/.nh-open-launcher
monitor=$base/wlan/nh-monitor
monitor_parameters=/sys/module/kiwi_v2/parameters
scan_results=$base/launcher-scan-results
channels24='2412 2417 2422 2427 2432 2437 2442 2447 2452 2457 2462'
channels5='5180 5200 5220 5240 5745 5765 5785 5805 5825'
nh=$base/nh-open
result=$base/launcher-result
downloads=/sdcard/Download/NetHunter
chroot=/data/local/nhsystem/kali-arm64
usb_state=/dev/.nh-open-launcher-usb
gadget=/config/usb_gadget/g1
config=$gadget/configs/b.1
description=$config/strings/0x409/configuration
arsenal=/data/data/com.offsec.nethunter/scripts/usbarsenal
umask 077

message() {
    printf '%s\n' "$*" >"$result.new"
    mv -f "$result.new" "$result"
}

ap_filter() {
    printf 'wlan addr1 %s or wlan addr2 %s or wlan addr3 %s' "$1" "$1" "$1"
}

cleanup() {
    trap - EXIT HUP INT TERM
    if [ -n "${child:-}" ]; then
        if [ "$mode" = survey ] || [ "$mode" = wifite ]; then
            kill -INT "$child" 2>/dev/null || true
            for attempt in 1 2 3; do
                kill -0 "$child" 2>/dev/null || break
                sleep 1
            done
        fi
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    if [ "$mode" = kismet ]; then
        if [ -e "$state/ready" ]; then
            message 'Kismet replay ended.'
        else
            message 'Kismet could not start. See the session log.'
        fi
    elif [ "$mode" != bluetooth ]; then
        "$monitor" stop || true
        wait "$launcher" 2>/dev/null || true
        if [ "$mode" = survey ] && [ -n "${access_point:-}" ] && [ -s "$chroot$file" ]; then
            # Airodump's BSSID filter still writes some unassociated control frames.
            scoped="$survey_dir/scoped.pcap"
            if "$nh" exec timeout -k 2 20 tcpdump -n -r "$file" -w "$scoped" "$(ap_filter "$access_point")"; then
                file="$scoped"
            else
                file=
                survey_filter_failed=1
            fi
        fi
        if [ "${survey_filter_failed:-0}" = 1 ]; then
            message 'Could not scope the survey PCAP to the selected access point. See the session log.'
        elif [ "$mode" = wifite ]; then
            if [ -n "${wifite_failed:-}" ]; then
                message 'Wifite exited with an error. Check NetHunter Terminal.'
            elif [ -e "$state/ready" ] || [ -e "$state/stop" ]; then
                message 'Wifite session ended.'
            else
                message 'Wifite could not prepare monitor mode. See the session log.'
            fi
        elif [ "$mode" = scan ]; then
            if [ -n "${scan_dir:-}" ]; then rm -rf "$chroot$scan_dir"; fi
            if [ -e "$state/stop" ]; then
                message 'Channel scan stopped.'
            elif [ -f "$scan_results" ]; then
                message 'Channel scan complete. Open Scan channels to view the results.'
            else
                message 'Channel scan could not finish. See the session log.'
            fi
        elif [ -n "${file:-}" ] && [ -s "$chroot$file" ]; then
            if mkdir -p "$downloads" && mv -f "$chroot$file" "$downloads/$name"; then
                if [ "$mode" = survey ]; then
                    if [ -s "$chroot$survey_prefix-01.csv" ] &&
                        mv -f "$chroot$survey_prefix-01.csv" "$downloads/${name%.pcap}.csv"; then
                        message "Survey PCAP and CSV saved in Downloads/NetHunter (${name%.pcap})."
                    else
                        message "Survey PCAP saved in Downloads/NetHunter/$name. No CSV was written."
                    fi
                elif [ -n "${access_point:-}" ] && [ "$(stat -c %s "$downloads/$name")" -eq 24 ]; then
                    message "No matching frames. Empty PCAP saved in Downloads/NetHunter/$name"
                else
                    message "Capture saved in Downloads/NetHunter/$name"
                fi
            else
                message 'Could not save capture to Downloads. See the session log.'
            fi
        elif [ -e "$state/stop" ]; then
            message 'Capture stopped before a file was written.'
        else
            message 'Capture could not start. See the session log.'
        fi
    else
        wait "$launcher" 2>/dev/null || true
        if [ -e "$state/stop" ] || [ -e "$state/ready" ]; then
            message 'Bad Bluetooth session ended.'
        else
            message 'Bad Bluetooth could not start. See the session log.'
        fi
    fi
    if [ -n "${survey_dir:-}" ]; then rm -rf "$chroot$survey_dir"; fi
    rm -f "$state/stop" "$state/ready" "$state/mode" "$state/networks"
    rmdir "$state"
}

start_monitor() {
    "$monitor" run passive "$1" "$2" &
    launcher=$!
    wait_for_monitor
}

wait_for_monitor() {
    for attempt in $(seq 1 20); do
        [ ! -e "$state/stop" ] && kill -0 "$launcher" 2>/dev/null || return 1
        if ip link show nhmon0 >/dev/null 2>&1 && grep -q 'nhmon0 ready' "$base/launcher.log"; then
            return 0
        fi
        sleep 1
    done
    return 1
}

run_wifite_terminal() {
    frequency=${1:-}
    duration=${2:-}
    case "$frequency" in [0-9][0-9][0-9][0-9]) ;; *) return 2 ;; esac
    case " $channels24 $channels5 " in *" $frequency "*) ;; *) return 2 ;; esac
    case "$duration" in ''|0*|*[!0-9]*) return 2 ;; esac
    [ "${#duration}" -le 3 ] && [ "$duration" -le 300 ] || return 2
    [ -t 0 ] && [ -t 1 ] || { echo 'Open Wifite in NetHunter Terminal.'; return 1; }
    [ ! -d "$usb_state" ] && [ ! -d /dev/.nh-open-wlan ] &&
        mkdir "$state" 2>/dev/null || { echo 'Restore normal mode before starting Wifite.'; return 1; }

    mode=wifite
    trap cleanup EXIT
    trap 'exit 130' HUP INT TERM
    printf '%s\n' "$mode" >"$state/mode"
    message 'Preparing nhmon0 for Wifite…'
    echo 'Preparing the OnePlus monitor interface…'
    # Binder calls in the monitor helper require a pipe rather than a file descriptor to the log.
    /system/bin/sh -c '"$@" 2>&1 | /system/bin/cat' sh \
        "$monitor" run passive "$frequency" "$((duration + 30))" >"$base/launcher.log" &
    launcher=$!
    if ! wait_for_monitor; then
        echo 'Could not prepare nhmon0. See View session log in the launcher.'
        return 1
    fi
    if [ "$frequency" -lt 2500 ]; then channel=$(((frequency - 2407) / 5))
    else channel=$(((frequency - 5000) / 5)); fi
    touch "$state/ready"
    message "Wifite running on channel $channel in receive-only mode."
    printf 'Wifite · nhmon0 · channel %s · receive-only · up to %s seconds\n' "$channel" "$duration"
    "$nh" exec env --default-signal=INT,QUIT timeout --foreground -k 4 "$duration" \
        wifite -i nhmon0 -c "$channel" --nodeauths --no-pmkid --skip-crack </dev/tty &
    child=$!
    while kill -0 "$child" 2>/dev/null; do
        if [ -e "$state/stop" ] || ! kill -0 "$launcher" 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    code=0
    wait "$child" || code=$?
    unset child
    case "$code" in
        0|124|130) ;;
        *) echo "Wifite exited with status $code."; wifite_failed=1 ;;
    esac
}

run_wifi() {
    name="$mode-$(date +%Y%m%d-%H%M%S)-$$.pcap"
    file="/tmp/$name"
    duration=$2
    access_point=${3:-}
    start_monitor "$1" "$((duration + 30))"
    if [ "$mode" = survey ]; then
        survey_dir=$(mktemp -d "$chroot/tmp/nh-survey.XXXXXX")
        survey_dir=${survey_dir#"$chroot"}
        survey_prefix="$survey_dir/capture"
        file="$survey_prefix-01.cap"
        if [ "$1" -lt 2500 ]; then channel=$((($1 - 2407) / 5))
        else channel=$((($1 - 5000) / 5)); fi
        set -- --channel "$channel" --background 1 --write-interval 1 \
            --output-format pcap,csv --write "$survey_prefix"
        if [ -n "$access_point" ]; then set -- "$@" --bssid "$access_point"; fi
        "$nh" exec env TERM=dumb timeout -k 3 -s INT "$duration" airodump-ng "$@" nhmon0 &
    else
        filter='type mgt subtype beacon'
        if [ "$mode" = lab ]; then
            filter=$(ap_filter "$access_point")
        elif [ -n "$access_point" ]; then
            filter="$filter and wlan addr3 $access_point"
        fi
        "$nh" exec tcpdump -n -U -i nhmon0 -Z root -w "$file" "$filter" &
    fi
    child=$!
    for second in $(seq 1 "$duration"); do
        [ ! -e "$state/stop" ] && kill -0 "$child" 2>/dev/null || return 0
        if [ -s "$chroot$file" ] && [ ! -e "$state/ready" ]; then
            touch "$state/ready"
            if [ "$mode" = survey ]; then
                message "Running a passive Airodump-ng survey for up to $duration seconds."
            elif [ "$mode" = lab ]; then
                message "Capturing frames involving the selected access point for up to $duration seconds."
            elif [ -n "$access_point" ]; then
                message "Capturing beacons from $access_point for up to $duration seconds."
            else
                message "Capturing Wi-Fi beacons. Stops automatically after $duration seconds."
            fi
        fi
        sleep 1
    done
}

run_scan() {
    case "$1" in
        24) frequencies=$channels24 ;;
        5) frequencies=$channels5 ;;
        all) frequencies="$channels24 $channels5" ;;
    esac
    scan_dir="/tmp/nh-launcher-scan-$$"
    start_monitor "${frequencies%% *}" 165
    mkdir "$chroot$scan_dir"
    index=0
    captured=0
    total=$(echo "$frequencies" | wc -w | tr -d ' ')
    for frequency in $frequencies; do
        [ ! -e "$state/stop" ] && kill -0 "$launcher" 2>/dev/null || return 0
        index=$((index + 1))
        message "Scanning $frequency MHz ($index of $total)…"
        # start_monitor has already tuned and refreshed the first channel.
        if [ "$index" -gt 1 ] && ! (
            echo "$frequency" >"$monitor_parameters/nh_monitor_frequency" &&
            echo 1 >"$monitor_parameters/nh_monitor_refresh_rx"
        ); then
            echo "Unable to tune to $frequency MHz." >&2
            continue
        fi
        "$nh" exec timeout 1.5 tcpdump -n -U -i nhmon0 -Z root -s 512 \
            -w "$scan_dir/$frequency.pcap" 'type mgt subtype beacon' &
        child=$!
        wait "$child" || true
        unset child
        if [ -s "$chroot$scan_dir/$frequency.pcap" ]; then
            captured=$((captured + 1))
        fi
    done
    [ ! -e "$state/stop" ] || return 0
    [ "$captured" -gt 0 ] || { echo 'No channel capture files were created.' >&2; return 1; }
    echo "Captured on $captured of $total requested channels."
    "$nh" exec python3 - "$scan_dir" <"$base/nh-scan-beacons.py" |
        sed -n 's/^NH-AP //p' >"$state/networks"
    mv "$state/networks" "$scan_results"
}

run_bluetooth() {
    "$base/nh-badbt" --app "$1" &
    launcher=$!
    for attempt in $(seq 1 30); do
        kill -0 "$launcher" 2>/dev/null || break
        if [ -s "$chroot/root/badbt/.app-peer" ]; then
            "$nh" exec env PYTHONUNBUFFERED=1 python3 /root/badbt/btk_server.py -n 'NH Lab Keyboard' -i hci0 &
            child=$!
            sleep 2
            break
        fi
        sleep 1
    done
    if [ -z "${child:-}" ]; then
        kill -TERM "$launcher" 2>/dev/null || true
        return 1
    fi
    for second in $(seq 1 290); do
        [ ! -e "$state/stop" ] && kill -0 "$child" 2>/dev/null || return 0
        if grep -q 'Waiting for the authorized receiver' "$base/launcher.log" && [ ! -e "$state/ready" ]; then
            touch "$state/ready"
            message 'Keyboard ready. Pair NH Lab Keyboard on your receiver, then use Bluetooth Arsenal to send.'
        fi
        sleep 1
    done
}

capture_path() {
    printf '%s\n' "$1" | grep -Eq '^(wifi|lab|survey)-[0-9]{8}-[0-9]{6}-[0-9]+\.pcap$' ||
        { echo 'Invalid capture name.'; return 2; }
    path="$downloads/$1"
    [ -f "$path" ] && [ ! -L "$path" ] || { echo 'This capture is no longer available.'; return 1; }
}

run_kismet() {
    capture_path "$1"
    "$nh" exec sh -c '
        set -eu
        umask 077
        work=/root/.nh-kismet
        mkdir -p "$work/.kismet"
        printf "%s\n" httpd_bind_address=127.0.0.1 httpd_port=12501 \
            remote_capture_listen=127.0.0.1 remote_capture_port=0 gps_enable=false >"$work/override.conf"
        if ss -ltn | grep -Eq ":12501[[:space:]]"; then
            echo "Port 12501 is already in use." >&2
            exit 1
        fi
        exec timeout -k 4 900 kismet --no-ncurses-wrapper --no-line-wrap \
            --homedir "$work" --override "$work/override.conf" -n -c "$1:type=pcapfile,pps=200"
    ' sh "$path" </dev/null &
    child=$!
    for attempt in $(seq 1 20); do
        [ ! -e "$state/stop" ] && kill -0 "$child" 2>/dev/null || return 1
        if "$nh" exec curl -fsS --max-time 1 http://127.0.0.1:12501/ -o /dev/null >/dev/null 2>&1; then
            touch "$state/ready"
            message 'Kismet replay ready. Open Kismet from Wireless tools. Ends after 15 minutes.'
            break
        fi
        sleep 1
    done
    [ -e "$state/ready" ] || return 1
    while [ ! -e "$state/stop" ] && kill -0 "$child" 2>/dev/null; do sleep 1; done
}

usb_is_adb_only() {
    [ "$(readlink "$config/f1" 2>/dev/null | sed 's|.*/||')" = ffs.adb ] &&
        [ "$(find "$config" -maxdepth 1 -type l | wc -l)" -eq 1 ] &&
        [ -n "$(cat "$gadget/UDC")" ]
}

usb_arsenal() {
    sh "$arsenal" -t "$(cat "$usb_state/target")" -f "$1" \
        -v "$(cat "$usb_state/vendor")" -p "$(cat "$usb_state/product")"
}

usb_restore() {
    [ -d "$usb_state" ] || return 0
    if ! usb_is_adb_only; then
        usb_arsenal reset
    fi
    if ! usb_is_adb_only; then
        echo 'USB is still restoring. Retry Restore normal mode.' >&2
        return 1
    fi
    cat "$usb_state/description" >"$description"
    rm -f "$usb_state/target" "$usb_state/vendor" "$usb_state/product" "$usb_state/description"
    rmdir "$usb_state"
}

[ "$(id -u)" = 0 ] || { echo 'Magisk root is required.' >&2; exit 1; }
case "${1:-status}" in
    wifite-terminal) run_wifite_terminal "${2:-}" "${3:-}" ;;
    wifi|wifi-ap|lab|survey|scan|bluetooth|kismet)
        mode=$1
        access_point=
        if [ "$mode" = wifi-ap ] || [ "$mode" = lab ] || [ -n "${4:-}" ]; then
            access_point=${4:-}
            printf '%s\n' "$access_point" | grep -Eq '^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$' ||
                { echo 'Invalid access-point address.'; exit 2; }
            if [ "$mode" = wifi-ap ]; then mode=wifi; fi
        fi
        if [ "$mode" = kismet ]; then
            capture_path "${2:-}"
        elif [ "$mode" != bluetooth ]; then
            if [ "$mode" != scan ]; then
                case " $channels24 $channels5 " in *" ${2:-none} "*) ;; *) exit 2 ;; esac
                case "${3:-}" in ''|0*|*[!0-9]*) exit 2 ;; esac
                [ "${#3}" -le 4 ] && [ "$3" -le 1770 ] ||
                    { echo 'Capture duration must be between 1 and 1770 seconds.'; exit 2; }
            else
                case "${2:-}" in 24|5|all) ;; *) exit 2 ;; esac
                [ -r "$base/nh-scan-beacons.py" ] || { echo 'Install the scan helper first.'; exit 1; }
            fi
            [ ! -d /dev/.nh-open-wlan ] || { echo 'A Wi-Fi monitor session is already running.'; exit 1; }
        else
            printf '%s\n' "${2:-}" | grep -Eq '^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$' || exit 2
            [ ! -e /dev/.nh-open-bt/active ] && [ ! -d /dev/.nh-open-badbt-lock ] ||
                { echo 'A Bluetooth session is already running.'; exit 1; }
        fi
        [ ! -d "$usb_state" ] || { echo "Restore USB mode before starting another session."; exit 1; }
        mkdir "$state" 2>/dev/null || { echo 'A launcher session is already running.'; exit 1; }
        printf '%s\n' "$mode" >"$state/mode"
        if [ "$mode" = scan ]; then rm -f "$scan_results"; fi
        message 'Starting session…'
        # Android Binder commands need a pipe for their output descriptors.
        nohup /system/bin/sh -c '"$@" 2>&1 | /system/bin/cat' sh \
            /system/bin/sh "$0" worker "$mode" "$2" "${3:-}" "$access_point" >"$base/launcher.log" 2>&1 </dev/null &
        ;;
    worker)
        mode=$2
        trap cleanup EXIT
        trap 'exit 130' HUP INT TERM
        case "$mode" in
            wifi|lab|survey) run_wifi "$3" "$4" "${5:-}" ;;
            scan) run_scan "$3" ;;
            bluetooth) run_bluetooth "$3" ;;
            kismet) run_kismet "$3" ;;
        esac
        ;;
    usb)
        case "${2:-}" in mac|lnx|win) ;; *) exit 2 ;; esac
        [ ! -d "$state" ] && [ ! -d "$usb_state" ] ||
            { echo 'Restore normal mode before starting USB HID.'; exit 1; }
        [ "$(getprop sys.usb.config)" = adb ] && usb_is_adb_only ||
            { echo 'Start from USB debugging mode with file transfer and tethering off.'; exit 1; }
        mkdir "$usb_state"
        printf '%s\n' "$2" >"$usb_state/target"
        cat "$gadget/idVendor" >"$usb_state/vendor"
        cat "$gadget/idProduct" >"$usb_state/product"
        cat "$description" >"$usb_state/description"
        if ! usb_arsenal adb,hid || [ ! -c /dev/hidg0 ] || [ ! -c /dev/hidg1 ] ||
            [ "$(readlink "$config/f2" | sed 's|.*/||')" != hid.0 ] ||
            [ "$(readlink "$config/f3" | sed 's|.*/||')" != hid.1 ]; then
            usb_restore
            echo 'USB keyboard and mouse could not be enabled.' >&2
            exit 1
        fi
        message 'USB keyboard and mouse enabled. Restore normal mode when finished.'
        ;;
    usb-test)
        [ -d "$usb_state" ] && [ -c /dev/hidg0 ] || exit 1
        timeout 4 /system/bin/sh -c '
            {
                printf "\000\000\021\000\000\000\000\000"
                printf "\000\000\000\000\000\000\000\000"
            } >/dev/hidg0
        ' || { echo 'The USB host did not accept the test key.' >&2; exit 1; }
        message 'Sent one lowercase n over USB.'
        ;;
    stop)
        if [ -d "$state" ]; then
            touch "$state/stop"
            for attempt in $(seq 1 35); do
                [ -d "$state" ] || break
                sleep 1
            done
            [ ! -d "$state" ] || { echo 'Session is still stopping. Try again shortly.'; exit 1; }
        fi
        "$monitor" stop
        "$nh" bluetooth-stop
        if [ -d "$usb_state" ]; then
            usb_restore
            message 'USB restored to ADB-only mode.'
        fi
        for attempt in $(seq 1 15); do
            if [ ! -d /dev/.nh-open-wlan ] && [ ! -e /dev/.nh-open-bt/active ]; then
                if [ ! -f "$result" ]; then message 'Android Wi-Fi and Bluetooth are ready.'; fi
                exit 0
            fi
            sleep 1
        done
        echo 'Android is still restoring the radios. Try again shortly.'
        exit 1
        ;;
    status)
        if [ -d "$usb_state" ]; then
            echo usb
        elif [ -d "$state" ] || [ -d /dev/.nh-open-wlan ] || [ -e /dev/.nh-open-bt/active ]; then
            echo active
        else
            echo idle
        fi
        if [ -f "$result" ]; then cat "$result"; else echo 'Android Wi-Fi and Bluetooth are ready.'; fi
        ;;
    captures)
        for file in "$downloads"/*.pcap; do
            [ -f "$file" ] && [ ! -L "$file" ] && printf '%s\n' "${file##*/}"
        done | grep -E '^(wifi|lab|survey)-[0-9]{8}-[0-9]{6}-[0-9]+\.pcap$' | sort -t- -k2,2r -k3,3r | head -40 || true
        ;;
    analyze)
        capture_path "${2:-}"
        case "${3:-summary}" in
            summary) [ -r "$base/nh-analyze-capture.py" ] || { echo 'Install the capture analyzer first.'; exit 1; }
                "$nh" exec timeout -k 2 45 python3 - "$path" <"$base/nh-analyze-capture.py" ;;
            wash) "$nh" exec timeout -k 2 20 wash --file "$path" </dev/null ;;
            hcx) "$nh" exec timeout -k 2 30 hcxpcapngtool "$path" </dev/null ;;
            *) exit 2 ;;
        esac
        ;;
    scan-results)
        if [ -f "$scan_results" ]; then cat "$scan_results"; else exit 1; fi
        ;;
    log)
        if [ -f "$base/launcher.log" ]; then tail -25 "$base/launcher.log"; else echo 'No launcher session yet.'; fi
        ;;
    *) exit 2 ;;
esac
