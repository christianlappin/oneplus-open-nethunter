diff --git a/hci_pty.c b/hci_pty.c
new file mode 100644
index 0000000..cc5d239
--- /dev/null
+++ b/hci_pty.c
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#define _GNU_SOURCE
+#include "hci_pty.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+#include <unistd.h>
+
+/* Stable Linux UAPI from drivers/bluetooth/hci_uart.h (not exported by libc). */
+#define HCIUARTSETPROTO _IOW('U', 200, int)
+#define HCIUARTGETDEVICE _IOR('U', 202, int)
+#define HCIUARTSETFLAGS _IOW('U', 203, int)
+#define HCI_UART_RAW_DEVICE 0
+#define HCI_UART_RESET_ON_INIT 1
+#define HCI_UART_H4 0
+
+void bluebinder_close_hci_pty(int *slave_fd)
+{
+    if (*slave_fd >= 0) {
+        int discipline = N_TTY;
+        /* Closing the last slave also unregisters HCI if this ioctl fails. */
+        if (ioctl(*slave_fd, TIOCSETD, &discipline))
+            perror("detach PTY HCI discipline");
+        close(*slave_fd);
+        *slave_fd = -1;
+    }
+}
+
+int bluebinder_open_hci_pty(int *slave_fd, int raw_device)
+{
+    int master = -1, slave = -1, discipline = N_HCI, saved_errno;
+    struct termios term;
+    char path[128];
+    *slave_fd = -1;
+    master = posix_openpt(O_RDWR | O_NOCTTY | O_CLOEXEC);
+    if (master < 0 || grantpt(master) || unlockpt(master)) goto fail;
+    int error = ptsname_r(master, path, sizeof(path));
+    if (error) { errno = error; goto fail; }
+    slave = open(path, O_RDWR | O_NOCTTY | O_CLOEXEC);
+    if (slave < 0 || tcgetattr(slave, &term)) goto fail;
+    cfmakeraw(&term);
+    term.c_cflag |= CLOCAL | CREAD;
+    if (tcsetattr(slave, TCSANOW, &term) ||
+        ioctl(slave, TIOCSETD, &discipline)) goto fail;
+    /* HAL handles firmware and physical UART initialization. H4 has no
+     * vendor setup hook. RESET_ON_INIT avoids an extra reset on close. */
+    unsigned long flags = raw_device ? 1UL << HCI_UART_RAW_DEVICE :
+                                      1UL << HCI_UART_RESET_ON_INIT;
+    if (ioctl(slave, HCIUARTSETFLAGS, flags) ||
+        ioctl(slave, HCIUARTSETPROTO, HCI_UART_H4)) goto fail;
+    int id = ioctl(slave, HCIUARTGETDEVICE, 0);
+    if (id < 0) goto fail;
+    fprintf(stderr, "PTY H4 transport registered hci%d on %s (%s)\n", id,
+            path, raw_device ? "synthetic test" : "HAL backend required");
+    *slave_fd = slave;
+    return master;
+fail:
+    saved_errno = errno;
+    if (slave >= 0) close(slave);
+    if (master >= 0) close(master);
+    errno = saved_errno;
+    return -1;
+}
diff --git a/hci_pty.h b/hci_pty.h
new file mode 100644
index 0000000..4fbad7c
--- /dev/null
+++ b/hci_pty.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef BLUEBINDER_HCI_PTY_H
+#define BLUEBINDER_HCI_PTY_H
+/* Returns a PTY master carrying H4 packets. Keep slave_fd open for its lifetime.
+ * Uses only a newly allocated PTY, never the physical Bluetooth UART.
+ * raw_device is for synthetic transport testing, not BlueZ operation. */
+int bluebinder_open_hci_pty(int *slave_fd, int raw_device);
+void bluebinder_close_hci_pty(int *slave_fd);
+#endif
