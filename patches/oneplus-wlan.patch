+/* Caller holds the psoc operation guard and RTNL across this snapshot. */
+int hdd_nh_dp_rx_state(void *handle, char *buffer)
+{
+	struct dp_soc *soc = handle;
+	struct dp_pdev *pdev;
+	struct dp_mon_pdev *mon;
+	struct dp_vdev *vdev;
+	unsigned int i, len = 0;
+
+	if (!soc || !soc->pdev_list[0] || !soc->monitor_soc)
+		return -ENODEV;
+	pdev = soc->pdev_list[0];
+	mon = pdev->monitor_pdev;
+	if (!mon)
+		return -ENODEV;
+	vdev = mon->mvdev;
+	len = scnprintf(buffer, PAGE_SIZE,
+		"intr=%u initialized=%u configured=%u vdev=%d callback=%u band=%u freq=%u full=%u vdev_timer=%u map=%u,%u,%u\n",
+		soc->intr_mode, qdf_atomic_read(&soc->cmn_init_done),
+		mon->monitor_configured, vdev ? vdev->vdev_id : -1,
+		!!(vdev && vdev->monitor_vdev && vdev->monitor_vdev->osif_rx_mon),
+		mon->mon_chan_band, mon->mon_chan_freq,
+		soc->monitor_soc->full_mon_mode,
+		dp_monitor_is_vdev_timer_running(soc),
+		pdev->ch_band_lmac_id_mapping[REG_BAND_2G],
+		pdev->ch_band_lmac_id_mapping[REG_BAND_5G],
+		pdev->ch_band_lmac_id_mapping[REG_BAND_6G]);
+	len += scnprintf(buffer + len, PAGE_SIZE - len,
+		"rx_tlv=%u monitor_tlv=%u context=%u status_done=%u dest_done=%u mpdu_done=%u mpdu_drop=%u reaped=%u mismatch=%u match=%u status_drop=%u dest_drop=%u invalid_link=%u invalid_desc=%u decap_invalid=%u\n",
+		soc->curr_rx_pkt_tlv_size, soc->rx_mon_pkt_tlv_size,
+		!!(vdev && vdev->osif_vdev),
+		mon->rx_mon_stats.status_ppdu_done,
+		mon->rx_mon_stats.dest_ppdu_done,
+		mon->rx_mon_stats.dest_mpdu_done,
+		mon->rx_mon_stats.dest_mpdu_drop,
+		mon->rx_mon_stats.mon_rx_bufs_reaped_dest,
+		mon->rx_mon_stats.ppdu_id_mismatch,
+		mon->rx_mon_stats.ppdu_id_match,
+		mon->rx_mon_stats.status_ppdu_drop,
+		mon->rx_mon_stats.dest_ppdu_drop,
+		mon->rx_mon_stats.mon_link_desc_invalid,
+		mon->rx_mon_stats.mon_rx_desc_invalid,
+		mon->rx_mon_stats.mpdu_decap_type_invalid);
+	for (i = 0; i < wlan_cfg_get_num_contexts(soc->wlan_cfg_ctx); i++)
+		len += scnprintf(buffer + len, PAGE_SIZE - len,
+			"ctx=%u monitor_mask=%x\n", i,
+			soc->intr_ctx[i].rx_mon_ring_mask);
+	for (i = 0; i < MAX_NUM_LMAC_HW; i++)
+		len += scnprintf(buffer + len, PAGE_SIZE - len,
+			"lmac=%u status=%u buffer=%u destination=%u interrupt=%u\n", i,
+			!!soc->rxdma_mon_status_ring[i].hal_srng,
+			!!soc->rxdma_mon_buf_ring[i].hal_srng,
+			!!soc->rxdma_mon_dst_ring[i].hal_srng,
+			soc->mon_intr_id_lmac_map[i]);
+	return len;
+}
+#endif
