+#ifdef CONFIG_NETHUNTER_MONITOR_TX
+/* Reapply the OEM payload/status filters after channel/hardware setup. */
+int hdd_nh_dp_refresh_monitor_rx(void *handle)
+{
+	struct dp_soc *soc = handle;
+	struct dp_pdev *pdev;
+	struct dp_mon_pdev *mon;
+	QDF_STATUS status;
+
+	if (!soc || !soc->pdev_list[0] || !hdd_nh_sta_backend_enabled())
+		return -ENODEV;
+	pdev = soc->pdev_list[0];
+	mon = pdev->monitor_pdev;
+	if (!mon || !mon->monitor_configured || !mon->mvdev)
+		return -ENODEV;
+	qdf_spin_lock_bh(&mon->mon_lock);
+	dp_mon_filter_setup_mon_mode(pdev);
+	status = dp_mon_filter_update(pdev);
+	qdf_spin_unlock_bh(&mon->mon_lock);
+	return qdf_status_to_os_return(status);
+}
+#endif
