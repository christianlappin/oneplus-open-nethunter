+    def accept_session(self):
+        errors = select.POLLHUP | select.POLLERR | select.POLLNVAL
+        print("Waiting for the authorized receiver")
+        while True:
+            control = self.accept_peer(self.scontrol)
+            if control is None:
+                continue
+            poll = select.poll()
+            poll.register(control, errors)
+            poll.register(self.sinterrupt, select.POLLIN)
+            events = dict(poll.poll(8000))
+            interrupt_ready = events.get(self.sinterrupt.fileno(), 0) & select.POLLIN
+            if not events.get(control.fileno(), 0) & errors and interrupt_ready:
+                interrupt = self.accept_peer(self.sinterrupt)
+                interrupt_ready = False
+                if interrupt is not None:
+                    self.ccontrol, self.cinterrupt = control, interrupt
+                    print("Authorized HID control and interrupt channels connected")
+                    for channel in (control, interrupt):
+                        GLib.io_add_watch(channel.fileno(), GLib.IO_HUP | GLib.IO_ERR, self.session_closed)
+                    return False
+            control.close()
+            # Drop a pending interrupt channel from the incomplete attempt.
+            if interrupt_ready:
+                pending, _ = self.sinterrupt.accept()
